NODE_ENV=development
PORT=5000
# Local MongoDB or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/solveitly
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7
# Website URL(s) allowed to call the API (comma-separated, no trailing slash).
# Production example: https://solveitly.netlify.app
CLIENT_URL=http://localhost:5173
# Login cookie SameSite: "lax" for local dev; "none" when the website and API are on different
# domains (Netlify + Render). "none" automatically makes the cookie Secure (HTTPS only).
COOKIE_SAMESITE=lax
# Production only: number of proxies in front of the API (Render = 1)
TRUST_PROXY=1
